NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu_clave_anonima
SUPABASE_SERVICE_ROLE_KEY=tu_clave_de_servicio

# Bancard vPOS (Fase 2 - tripwire "Hoja de Ruta 90 Dias")
# Claves del Portal de Comercios de Bancard. BANCARD_ENVIRONMENT=production
# usa https://vpos.infonet.com.py; cualquier otro valor (o ausente) usa el
# staging https://vpos.infonet.com.py:8888.
BANCARD_PUBLIC_KEY=tu_public_key
BANCARD_PRIVATE_KEY=tu_private_key
BANCARD_ENVIRONMENT=staging
# URL del script bancard-checkout-js. Bancard no publica un CDN fijo: hay
# que descargarlo/generarlo desde github.com/Bancard/bancard-checkout-js
# (o el paquete que entregue el Portal de Comercios) y alojarlo ustedes
# mismos (p. ej. en /public y apuntar aca a "/bancard-checkout-x.x.x.js").
NEXT_PUBLIC_BANCARD_CHECKOUT_JS_URL=
