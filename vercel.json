{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/keto", "destination": "/?disciplina=keto" },
    { "source": "/low-carb", "destination": "/?disciplina=low-carb" },
    { "source": "/healthy-habits", "destination": "/?disciplina=healthy-habits" },
    { "source": "/neuroplasticidad", "destination": "/?disciplina=neuroplasticidad" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    },
    {
      "source": "/(css|js)/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, must-revalidate" }
      ]
    }
  ]
}
